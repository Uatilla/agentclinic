{
  "name": "agentclinic",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "npm run typecheck && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@picocss/pico": "^2.1.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "better-sqlite3": false
  }
}
